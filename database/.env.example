# =====================================================================
#  Template konfigurasi MariaDB — drupal/database
#  Pakai:  cp .env.example .env   lalu ubah password & port bila perlu.
# =====================================================================

# --- identitas project compose & container ---
COMPOSE_PROJECT_NAME=drupal_database
CONTAINER_NAME=mariadb_drupal

# --- jaringan docker (harus sama dengan ../web/.env) ---
NETWORK_NAME=drupal-network
MARIADB_IP=172.22.0.3

# --- versi image ---
MARIADB_VERSION=10.11

# --- kredensial database ---
MARIADB_ROOT_PASSWORD=ubah_password_root_ini
MARIADB_DATABASE=drupal
MARIADB_USER=drupal
MARIADB_PASSWORD=ubah_password_drupal_ini

# --- port host -> container 3306 ---
MARIADB_PORT=3306
MARIADB_BIND=0.0.0.0

# --- penyimpanan data di host ---
DATA_DIR=./data

# --- timezone ---
TZ=Asia/Jakarta

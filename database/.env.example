# =====================================================================
#  Template konfigurasi MariaDB — drupal/database
#
#  Untuk project baru, JANGAN diedit manual. Dari root repo jalankan:
#     make init NAME=proyek2     # buat .env + network (belum start)
#     make new  NAME=proyek2     # init + start + composer install + settings
#  Script mengisi nama container, network, subnet, IP statis, port, dan
#  password acak secara otomatis sehingga tiap project unik & tidak bentrok.
#
#  Manual (bila perlu): cp .env.example .env  lalu sesuaikan nilainya.
#  Catatan: nilai di sini KONKRET (bukan ${...}) supaya Makefile & shell
#  tidak salah mengosongkannya. Nama/port harus sama dengan ../web/.env.
# =====================================================================

# --- identitas project (diatur otomatis oleh `make init`) ---
PROJECT_NAME=drupal
COMPOSE_PROJECT_NAME=drupal_database
CONTAINER_NAME=drupal_db

# --- jaringan docker (harus sama dengan ../web/.env) ---
NETWORK_NAME=drupal-network
# dipakai `make network` saat membuat network (harus sama di kedua .env)
NETWORK_SUBNET=172.22.0.0/24
MARIADB_IP=172.22.0.3

# --- versi image ---
MARIADB_VERSION=10.11

# --- kredensial database ---
MARIADB_ROOT_PASSWORD=ubah_password_root_ini
MARIADB_DATABASE=drupal
MARIADB_USER=drupal
MARIADB_PASSWORD=ubah_password_drupal_ini

# --- port host -> container 3306 ---
MARIADB_PORT=3306
MARIADB_BIND=0.0.0.0

# --- penyimpanan data di host ---
DATA_DIR=./data

# --- timezone ---
TZ=Asia/Jakarta


# --- versi image ---
MARIADB_VERSION=10.11

# --- kredensial database ---
MARIADB_ROOT_PASSWORD=ubah_password_root_ini
MARIADB_DATABASE=drupal
MARIADB_USER=drupal
MARIADB_PASSWORD=ubah_password_drupal_ini

# --- port host -> container 3306 ---
MARIADB_PORT=3306
MARIADB_BIND=0.0.0.0

# --- penyimpanan data di host ---
DATA_DIR=./data

# --- timezone ---
TZ=Asia/Jakarta


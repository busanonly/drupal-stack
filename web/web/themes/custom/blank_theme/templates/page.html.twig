{#
/**
 * @file
 * Template halaman utama — theme blank_theme.
 *
 * Region yang tersedia (lihat blank_theme.info.yml):
 * page.header, page.header_search, page.primary_menu, page.breadcrumb,
 * page.highlighted, page.page_title, page.help, page.content,
 * page.sidebar_first, page.footer.
 * page.header, page.header_search, dan page.primary_menu dirender di dalam
 * templates/header.html.twig (bar atas); page.page_title dirender sebagai
 * judul halaman (blok Page title).
 *
 * Variabel berguna: title, title_prefix, title_suffix, tabs, messages,
 * is_front, logged_in, is_admin, front_page, blank_header (lihat
 * blank_theme.theme).
 *
 * Catatan pesan sistem: blok bawaan "Messages" selalu dicetak walau kosong,
 * jadi blank_theme_preprocess_page() melepasnya dari region `highlighted`
 * (yang akan jadi pita kosong) dan menyiapkan variabel `messages` yang
 * dicetak di dalam area konten.
 */
#}
{#
  Header situs. Sengaja dirender di luar .layout-container supaya bar-nya
  selebar layar; isi di dalamnya dibatasi oleh .site-header__inner.
#}
{% include '@blank_theme/header.html.twig' with {
  brand: page.header,
  nav: page.primary_menu,
  search: page.header_search,
} %}

{#
  Hero halaman depan (templates/hero.html.twig) — tepat di bawah header.
  Sengaja di luar .layout-container agar latar & fotonya selebar layar, sama
  seperti header. Hero merender dirinya sendiri hanya bila aktif (lihat
  blank_theme_hero() di blank_theme.theme): pengaturan hero_enabled dan
  hero_front_only.
#}
{% include '@blank_theme/hero.html.twig' %}

<div class="layout-container">

  {% if page.breadcrumb %}
    <div class="site-breadcrumb">
      {{ page.breadcrumb }}
    </div>
  {% endif %}

  {# Region `highlighted` hanya dirender bila benar-benar ada blok lain di
     dalamnya — blok "Messages" bawaan sudah dipindahkan ke area konten oleh
     blank_theme_preprocess_page(), sehingga tidak ada pita kosong. #}
  {% if page.highlighted %}
    <div class="site-highlighted">
      {{ page.highlighted }}
    </div>
  {% endif %}

  {% if page.help %}
    <div class="site-help">
      {{ page.help }}
    </div>
  {% endif %}

  {# Judul halaman: dari blok Page title (region page_title). Variabel `title`
     dipakai sebagai cadangan bila blok itu dilepas dari Block layout.
     Di halaman depan yang memakai hero, judul ini disembunyikan karena hero
     sudah membawa <h1> (pengaturan hero_hide_page_title; nilai dihitung di
     blank_theme_preprocess_page()). #}
  {% set hide_page_title = blank_hide_page_title|default(false) %}
  {{ title_prefix }}
  {% if not hide_page_title %}
    {% if page.page_title %}
      <div class="page-header">
        {{ page.page_title }}
      </div>
    {% elseif title %}
      <h1 class="page-title">{{ title }}</h1>
    {% endif %}
  {% endif %}
  {{ title_suffix }}

  {% set has_sidebar = page.sidebar_first is not empty %}
  <main id="main-content" class="layout-main{{ has_sidebar ? ' has-sidebar' }}">
    <div class="layout-content">

      {# Pesan sistem (status/peringatan/error) disiapkan oleh
         blank_theme_preprocess_page(). Isinya <div data-drupal-messages-fallback>
         + placeholder, sehingga pesan dari AJAX/JavaScript juga tampil di sini
         (lihat core/misc/message.js). #}
      {{ messages }}

      {% if tabs %}
        <nav class="page-tabs">
          {{ tabs }}
        </nav>
      {% endif %}

      {{ page.content }}

    </div>

    {% if has_sidebar %}
      <aside class="layout-sidebar-first">
        {{ page.sidebar_first }}
      </aside>
    {% endif %}
  </main>

  {% if page.footer %}
    <footer class="site-footer">
      {{ page.footer }}
    </footer>
  {% endif %}

</div>

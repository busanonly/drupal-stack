{#
/**
 * @file
 * Header situs — theme blank_theme.
 *
 * Dipanggil dari page.html.twig lewat {% include %} dengan 3 region:
 * - brand  : region "header"        → blok Site branding (logo + nama + tagline).
 * - nav    : region "primary_menu"  → blok Main navigation.
 * - search : region "header_search" → opsional; bila kosong dipakai form bawaan.
 *
 * Variabel lain dari blank_theme_preprocess_page() (lihat blank_theme.theme):
 * - blank_header.sticky          : header sticky/tidak.
 * - blank_header.nav             : link menu bawaan (fallback) — dipakai bila
 *                                  region "primary_menu" kosong.
 * - blank_header.search.enabled  : tampilkan form pencarian bawaan.
 * - blank_header.search.action   : tujuan submit form (mis. /search/node).
 * - blank_header.search.placeholder
 * - blank_header.cta.enabled|label|url|external : tombol CTA (WhatsApp/link).
 *
 * Semua nilai di atas diubah di Appearance > Settings (theme blank_theme).
 */
#}
{% set header = blank_header|default({'sticky': false, 'nav': [], 'search': {}, 'cta': {}}) %}
<header class="site-header{{ header.sticky ? ' site-header--sticky' : '' }}" data-header data-open="false">
  <div class="site-header__inner">

    {# Brand: diisi blok Site branding (region header). #}
    <div class="site-header__brand">
      {% if brand %}
        {{ brand }}
      {% else %}
        <a class="site-brand__name" href="{{ path('<front>') }}" rel="home">{{ 'Home'|t }}</a>
      {% endif %}
    </div>

    {# Tombol menu untuk layar kecil (< 1200px). #}
    <button class="site-header__toggle" type="button"
      data-header-toggle
      aria-expanded="false"
      aria-controls="site-header-panel"
      aria-label="{{ 'Buka menu'|t }}"
      data-label-open="{{ 'Buka menu'|t }}"
      data-label-close="{{ 'Tutup menu'|t }}">
      <span class="site-header__toggle-bar" aria-hidden="true"></span>
      <span class="site-header__toggle-bar" aria-hidden="true"></span>
      <span class="site-header__toggle-bar" aria-hidden="true"></span>
    </button>

    {# Panel: menu + pencarian + CTA (sejajar di desktop, menurun di mobile). #}
    <div class="site-header__panel" id="site-header-panel" data-header-panel>

      <div class="site-header__nav">
        {% if nav %}
          {{ nav }}
        {% elseif header.nav %}
          <nav aria-label="{{ 'Navigasi utama'|t }}">
            <ul class="header-menu">
              {% for link in header.nav %}
                <li class="header-menu__item">
                  <a class="header-menu__link{{ link.active ? ' is-active' : '' }}" href="{{ link.href }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.label }}</a>
                </li>
              {% endfor %}
            </ul>
          </nav>
        {% endif %}
      </div>

      {% if search %}
        <div class="site-header__search">{{ search }}</div>
      {% elseif header.search.enabled %}
        <div class="site-header__search">
          <form class="header-search" action="{{ header.search.action }}" method="get" role="search">
            <label class="visually-hidden" for="header-search-input">{{ 'Cari'|t }}</label>
            <input class="header-search__input" id="header-search-input" type="search" name="keys"
              placeholder="{{ header.search.placeholder }}" autocomplete="off" />
            <button class="header-search__submit" type="submit" aria-label="{{ 'Cari'|t }}">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="M16.5 16.5 21 21"></path>
              </svg>
            </button>
          </form>
        </div>
      {% endif %}

      {% if header.cta.enabled %}
        <div class="site-header__cta">
          <a class="header-cta" href="{{ header.cta.url }}"{% if header.cta.external %} target="_blank" rel="noopener noreferrer"{% endif %}>
            <span class="header-cta__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.966 1.164-.198.199-.396.223-.693.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.347-.347.52-.52.174-.174.232-.298.347-.497.116-.198.058-.371-.058-.52-.115-.148-.66-1.585-.904-2.16-.235-.56-.472-.482-.65-.49l-.557-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 016.988 2.896 9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path>
              </svg>
            </span>
            <span class="header-cta__label">{{ header.cta.label }}</span>
          </a>
        </div>
      {% endif %}

    </div>
  </div>
</header>

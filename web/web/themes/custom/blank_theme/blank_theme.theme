/**
 * Format harga untuk tampilan: "Rp 65.000" (desain memakai spasi setelah simbol).
 *
 * @param \Drupal\commerce_price\Price|null $price
 *   Harga Commerce.
 *
 * @return string
 *   Harga siap tampil, atau string kosong bila harga tidak ada.
 */
function blank_theme_produk_format_harga($price) {
  if (!$price) {
    return '';
  }
  // CurrencyFormatter Commerce extends formatter commerceguys: parameternya
  // angka + kode mata uang (bukan objek Price).
  $teks = (string) \Drupal::service('commerce_price.currency_formatter')
    ->format($price->getNumber(), $price->getCurrencyCode());
  // Formatter Commerce menulis "Rp65.000" untuk IDR; desain memakai "Rp 65.000".
  return trim(preg_replace('/^(Rp|IDR)\s*/u', 'Rp ', $teks));
}

/**
 * URL WhatsApp dari pengaturan header, atau fallback ke path lain.
 *
 * @param string $fallback
 *   Path internal yang dipakai bila nomor WhatsApp belum diisi.
 *
 * @return array
 *   ['url' => string, 'external' => bool].
 */
function blank_theme_whatsapp_url($fallback = '/kontak') {
  $nomor = preg_replace('/\D+/', '', (string) blank_theme_setting('header_whatsapp'));
  if ($nomor !== '') {
    return ['url' => 'https://wa.me/' . $nomor, 'external' => TRUE];
  }
  return ['url' => blank_theme_link_url($fallback), 'external' => FALSE];
}

/**
 * Susun variabel halaman produk untuk templates/commerce-product--produk--full.
 *
 * Semua teks diambil dari pengaturan theme (Appearance > Settings), sedangkan
 * data produk (harga, stok, spesifikasi, ulasan) dari field Commerce.
 *
 * @param \Drupal\commerce_product\Entity\ProductInterface $product
 *   Produk yang sedang dilihat.
 *
 * @return array
 *   Variabel siap pakai untuk template.
 */
function blank_theme_produk($product) {
  // --- Galeri foto dari field_galeri (thumbnail memakai image style bawaan) ---
  $galeri = [];
  $thumb_style = \Drupal::entityTypeManager()->getStorage('image_style')->load('thumbnail');
  $galeri_items = $product->hasField('field_galeri') ? $product->get('field_galeri') : [];
  foreach ($galeri_items as $item) {
    $file = $item->entity;
    if (!$file) {
      continue;
    }
    $uri = $file->getFileUri();
    $gambar = \Drupal::service('image.factory')->get($uri);
    $galeri[] = [
      'url' => \Drupal::service('file_url_generator')->generateString($uri),
      'thumb' => $thumb_style ? $thumb_style->buildUrl($uri) : \Drupal::service('file_url_generator')->generateString($uri),
      'alt' => trim((string) $item->alt) !== '' ? $item->alt : $product->label(),
      'width' => $gambar ? $gambar->getWidth() : NULL,
      'height' => $gambar ? $gambar->getHeight() : NULL,
    ];
  }

  // --- Variasi: harga, diskon, stok (juga dikirim ke js/produk.js) ---
  $diskon_label = (string) blank_theme_setting('produk_discount_label');
  $satuan = (string) blank_theme_setting('produk_stock_unit');
  $variasi = [];
  foreach ($product->getVariations() as $variation) {
    if (!$variation->isPublished()) {
      continue;
    }
    $harga = $variation->getPrice();
    $coret = $variation->getListPrice();
    $diskon = 0;
    if ($harga && $coret && (float) $coret->getNumber() > (float) $harga->getNumber()) {
      $diskon = (int) round(((float) $coret->getNumber() - (float) $harga->getNumber()) / (float) $coret->getNumber() * 100);
    }
    $stok = $variation->hasField('field_stok') && !$variation->get('field_stok')->isEmpty()
      ? (int) $variation->get('field_stok')->value
      : NULL;
    $atribut = $variation->hasField('attribute_ukuran') ? $variation->getAttributeValueId('attribute_ukuran') : NULL;
    $label = NULL;
    if ($atribut && ($value = $variation->getAttributeValue('attribute_ukuran'))) {
      $label = $value->label();
    }
    $variasi[] = [
      'id' => (int) $variation->id(),
      'attribute' => (int) $atribut,
      'label' => $label,
      'harga' => blank_theme_produk_format_harga($harga),
      'harga_coret' => $diskon ? blank_theme_produk_format_harga($coret) : '',
      'diskon' => $diskon,
      'diskon_label' => $diskon_label,
      'stok' => $stok === NULL ? '' : $stok . ($satuan !== '' ? ' ' . $satuan : ''),
    ];
  }
  // Variasi pertama = variasi default Commerce (sama dengan radio yang terpilih).
  $utama = $variasi ? reset($variasi) : NULL;

  // --- Spesifikasi: label field + nilainya (tabel di halaman produk) ---
  $spesifikasi = [['label' => t('Nama Produk'), 'nilai' => $product->label()]];
  $ukuran = [];
  foreach ($variasi as $variasi_ukuran) {
    if (!empty($variasi_ukuran['label'])) {
      $ukuran[$variasi_ukuran['label']] = TRUE;
    }
  }
  $field_variation = \Drupal::service('entity_field.manager')->getFieldDefinitions('commerce_product_variation', 'produk');
  if ($ukuran && isset($field_variation['attribute_ukuran'])) {
    $spesifikasi[] = [
      'label' => $field_variation['attribute_ukuran']->getLabel(),
      'nilai' => implode(', ', array_keys($ukuran)),
    ];
  }
  foreach (['field_bahan', 'field_warna', 'field_berat', 'field_perawatan', 'field_minimum_order', 'field_custom'] as $nama_field) {
    if (!$product->hasField($nama_field) || $product->get($nama_field)->isEmpty()) {
      continue;
    }
    $nilai = (string) $product->get($nama_field)->getString();
    if ($nama_field === 'field_minimum_order' && $satuan !== '') {
      $nilai .= ' ' . $satuan;
    }
    $spesifikasi[] = [
      'label' => $product->get($nama_field)->getFieldDefinition()->getLabel(),
      'nilai' => $nilai,
    ];
  }

  // --- Poin unggulan & ulasan (field multi-value, teks bebas) ---
  $keunggulan = [];
  if ($product->hasField('field_keunggulan')) {
    foreach ($product->get('field_keunggulan') as $item) {
      if (trim((string) $item->value) !== '') {
        $keunggulan[] = $item->value;
      }
    }
  }
  $ulasan = [];
  if ($product->hasField('field_ulasan')) {
    foreach ($product->get('field_ulasan') as $item) {
      if (trim((string) $item->value) !== '') {
        // Teks bebas: hanya baris baru yang dipertahankan sebagai HTML.
        $ulasan[] = Markup::create(nl2br(Html::escape($item->value)));
      }
    }
  }

  // --- 4 keunggulan: "Label|Subteks|ikon" per baris ---
  $fitur = [];
  foreach (blank_theme_lines(blank_theme_setting('produk_features')) as $baris) {
    $bagian = array_pad(explode('|', $baris, 3), 3, '');
    if (trim($bagian[0]) === '') {
      continue;
    }
    $fitur[] = [
      'label' => trim($bagian[0]),
      'sub' => trim($bagian[1]),
      'ikon' => trim($bagian[2]) !== '' ? trim($bagian[2]) : '✓',
    ];
  }

  // --- Angka ringkas (rating/ulasan/terjual) ---
  $rating = $product->hasField('field_rating') && !$product->get('field_rating')->isEmpty()
    ? (float) $product->get('field_rating')->value
    : 0.0;
  $ulasan_jumlah = $product->hasField('field_jumlah_ulasan') && !$product->get('field_jumlah_ulasan')->isEmpty()
    ? (int) $product->get('field_jumlah_ulasan')->value
    : 0;
  $terjual = $product->hasField('field_terjual') && !$product->get('field_terjual')->isEmpty()
    ? (int) $product->get('field_terjual')->value
    : 0;
  $whatsapp = blank_theme_whatsapp_url();

  return [
    'galeri' => $galeri,
    'variasi' => $variasi,
    'variasi_utama' => $utama,
    'crumb_home' => (string) blank_theme_setting('produk_crumb_home'),
    'crumb_catalog' => (string) blank_theme_setting('produk_crumb_catalog'),
    'crumb_catalog_url' => blank_theme_link_url((string) blank_theme_setting('produk_crumb_catalog_url')),
    'harga' => $utama ? $utama['harga'] : '',
    'harga_coret' => $utama ? $utama['harga_coret'] : '',
    'diskon' => $utama ? $utama['diskon'] : 0,
    'diskon_label' => $diskon_label,
    'stok' => $utama ? $utama['stok'] : '',
    'stok_label' => (string) blank_theme_setting('produk_stock_label'),
    'rating' => $rating ? number_format($rating, 1, '.', '') : '',
    'rating_bulat' => (int) round($rating),
    'ulasan_jumlah' => $ulasan_jumlah,
    'ulasan_label' => (string) blank_theme_setting('produk_review_label'),
    'terjual' => $terjual,
    'terjual_format' => $terjual >= 1000 ? number_format($terjual, 0, ',', '.') . '+' : (string) $terjual,
    'terjual_label' => (string) blank_theme_setting('produk_sold_label'),
    'ringkasan' => trim((string) ($product->hasField('body') ? $product->get('body')->summary : '')),
    'keunggulan' => $keunggulan,
    'ulasan' => $ulasan,
    'ulasan_kosong' => (string) blank_theme_setting('produk_empty_review'),
    'spesifikasi' => $spesifikasi,
    'spesifikasi_kosong' => (string) blank_theme_setting('produk_empty_specification'),
    'fitur' => $fitur,
    'tab_deskripsi' => (string) blank_theme_setting('produk_tab_description'),
    'tab_spesifikasi' => (string) blank_theme_setting('produk_tab_specification'),
    'tab_ulasan' => (string) blank_theme_setting('produk_tab_review'),
    'grosir_title' => (string) blank_theme_setting('produk_grosir_title'),
    'grosir_text' => (string) blank_theme_setting('produk_grosir_text'),
    'grosir_label' => (string) blank_theme_setting('produk_grosir_label'),
    'custom_title' => (string) blank_theme_setting('produk_custom_title'),
    'custom_text' => (string) blank_theme_setting('produk_custom_text'),
    'custom_label' => (string) blank_theme_setting('produk_custom_label'),
    'wish_label' => (string) blank_theme_setting('produk_wish_label'),
    'wa_url' => $whatsapp['url'],
    'wa_label' => (string) blank_theme_setting('produk_whatsapp_label'),
  ];
}

/**
 * Menyiapkan variabel halaman produk (templates/commerce-product--produk--full).
 */
function blank_theme_preprocess_commerce_product(array &$variables): void {
  // Variabel `product` dari Commerce berisi elemen field (array), bukan entity;
  // entity-nya ada di elements['#commerce_product'] (lihat
  // CommerceProductThemeHooks::preprocessCommerceProduct()).
  $product = $variables['elements']['#commerce_product'] ?? NULL;
  if (!$product) {
    return;
  }
  $produk = blank_theme_produk($product);
  // Commerce tidak menyediakan variabel `content` (yang ada: elements, product,
  // product_entity). Template theme memakai konvensi content.* seperti template
  // core, jadi element field diarahkan ke sana.
  $variables['content'] = $variables['elements'];
  $variables['blank_produk'] = $produk;
  // Peta variasi untuk js/produk.js: harga & stok ikut berubah saat ukuran
  // diganti tanpa perlu request ulang.
  $variables['#attached']['drupalSettings']['blankProduk']['variations'] = $produk['variasi'];
  // Label tombol -/+ jumlah (dipakai js/produk.js; tombolnya dibuat di JS
  // karena markup form Commerce tidak menyediakan slot markup).
  $variables['#attached']['drupalSettings']['blankProduk']['label'] = [
    'stepDown' => t('Kurangi jumlah'),
    'stepUp' => t('Tambah jumlah'),
  ];
}

/**
 * Penyesuaian form "Add to cart" Commerce di halaman produk.
 *
 * Label (Pilih Ukuran, Jumlah, tombol keranjang) diambil dari pengaturan theme
 * supaya bisa diubah tanpa edit kode; tombol WhatsApp ditambahkan di samping
 * tombol keranjang, plus stepper -/+ untuk field jumlah.
 */
function blank_theme_form_alter(array &$form, FormStateInterface $form_state, $form_id): void {
  // Form id-nya per produk: commerce_order_item_add_to_cart_form_commerce_product_1.
  if (!str_starts_with($form_id, 'commerce_order_item_add_to_cart_form')) {
    return;
  }

  if (isset($form['actions']['submit']['#value'])) {
    $form['actions']['submit']['#value'] = blank_theme_setting('produk_cart_label');
  }

  // Tombol WhatsApp (link) di samping tombol keranjang.
  $whatsapp = blank_theme_whatsapp_url();
  $url = $whatsapp['external']
    ? Url::fromUri($whatsapp['url'], ['attributes' => ['target' => '_blank', 'rel' => 'noopener']])
    : Url::fromUserInput($whatsapp['url']);
  $form['actions']['whatsapp'] = [
    '#type' => 'link',
    '#title' => blank_theme_setting('produk_whatsapp_label'),
    '#url' => $url,
    '#attributes' => ['class' => ['produk__wa']],
    '#weight' => 10,
  ];

  // Judul fieldset atribut (mis. "Ukuran" → "Pilih Ukuran"). Struktur field
  // widget Commerce: [field][widget][delta][...].
  if (isset($form['purchased_entity']['widget'][0]['attributes']['attribute_ukuran']['#title'])) {
    $form['purchased_entity']['widget'][0]['attributes']['attribute_ukuran']['#title'] = blank_theme_setting('produk_size_label');
  }

  // Field jumlah: label saja; tombol -/+ dibuat js/produk.js (markup form dari
  // Commerce tidak menyediakan slot markup untuknya, dan #prefix difilter XSS).
  if (isset($form['quantity']['widget'][0]['value'])) {
    $form['quantity']['widget'][0]['value']['#title'] = blank_theme_setting('produk_quantity_label');
  }
}


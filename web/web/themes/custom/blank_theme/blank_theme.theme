<?php

/**
 * @file
 * Hook dan fungsi untuk theme Blank Theme.
 *
 * Theme kosongan: isinya sengaja dikosongkan. Pola nama fungsi hook adalah
 * <machine_name>_<hook>, contoh: blank_theme_preprocess_page().
 *
 * Contoh-contoh di bawah sengaja dikomentari — hapus komentar bila dipakai.
 */

use Drupal\block\BlockInterface;
use Drupal\Component\Utility\Html;
use Drupal\Core\Block\MessagesBlockPluginInterface;
use Drupal\Core\Extension\ThemeSettingsProvider;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\Core\Render\Markup;
use Drupal\Core\Url;


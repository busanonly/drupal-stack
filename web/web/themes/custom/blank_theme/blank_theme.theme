  ];

  $form['blank_theme_hero']['hero_badge'] = [
    '#type' => 'textarea',
    '#title' => t('Teks bulatan pink (dekorasi)'),
    '#default_value' => blank_theme_setting('hero_badge'),
    '#rows' => 4,
    '#description' => t('Satu baris per baris. Hanya tampil di layar ≥ 1200px.'),
  ];

  $form['blank_theme_hero']['hero_image'] = [
    '#type' => 'textfield',
    '#title' => t('Foto hero'),
    '#default_value' => blank_theme_setting('hero_image'),
    '#description' => t('Kosongkan untuk memakai gambar bawaan theme <code>images/hero-boneka.webp</code> (foto boneka di sisi kanan). Isi dengan path internal seperti <code>/sites/default/files/hero.jpg</code> atau URL penuh untuk menggantinya.'),
  ];
}

/**
 * Contoh hook lain yang sering dipakai (sengaja dikomentari):
 *
 * function blank_theme_preprocess_html(array &$variables): void {
 *   $variables['attributes']['class'][] = 'theme-blank_theme';
 * }
 *
 * function blank_theme_theme_suggestions_page_alter(array &$suggestions, array $variables): void {
 *   if ($variables['is_front']) {
 *     $suggestions[] = 'blank_theme_page__front';
 *   }
 * }
 */

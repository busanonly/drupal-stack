    '#default_value' => (bool) blank_theme_setting('hero_hide_page_title'),
    '#description' => t('Hero sudah membawa <code>&lt;h1&gt;</code>, jadi judul halaman tidak dirender dua kali. Hanya berlaku di halaman depan.'),

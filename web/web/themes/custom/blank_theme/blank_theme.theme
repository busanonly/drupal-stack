    '#default_value' => blank_theme_setting('hero_eyebrow'),
    '#description' => t('Kosongkan untuk menyembunyikannya. Teks ditampilkan kapital (huruf besar).'),
  ];

  $form['blank_theme_hero']['hero_title'] = [
    '#type' => 'textfield',
    '#title' => t('Judul — baris pertama'),
    '#default_value' => blank_theme_setting('hero_title'),
    '#description' => t('Judul hero adalah <code>&lt;h1&gt;</code> halaman depan.'),
  ];

  $form['blank_theme_hero']['hero_title_accent'] = [
    '#type' => 'textfield',
    '#title' => t('Judul — baris kedua (warna aksen)'),
    '#default_value' => blank_theme_setting('hero_title_accent'),
    '#description' => t('Selalu ditampilkan sebagai baris baru di bawah baris pertama.'),
  ];

  $form['blank_theme_hero']['hero_lead'] = [

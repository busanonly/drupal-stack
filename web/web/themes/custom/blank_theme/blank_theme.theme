  $form['blank_theme_hero']['hero_cta_label'] = [
    '#type' => 'textfield',
    '#title' => t('Tombol utama — label'),
    '#default_value' => blank_theme_setting('hero_cta_label'),
  ];

  $form['blank_theme_hero']['hero_cta_url'] = [
    '#type' => 'textfield',
    '#title' => t('Tombol utama — tujuan'),
    '#default_value' => blank_theme_setting('hero_cta_url'),
    '#description' => t('Contoh: <code>/produk</code>. Kosongkan labelnya untuk menyembunyikan tombol.'),
  ];

  $form['blank_theme_hero']['hero_secondary_label'] = [
    '#type' => 'textfield',
    '#title' => t('Tombol kedua — label'),
    '#default_value' => blank_theme_setting('hero_secondary_label'),
    '#description' => t('Umumnya tombol WhatsApp. Bila <em>Nomor WhatsApp</em> di bagian Header diisi, tombol ini otomatis mengarah ke <code>https://wa.me/...</code>.'),
  ];

  $form['blank_theme_hero']['hero_secondary_url'] = [
    '#type' => 'textfield',
    '#title' => t('Tombol kedua — tujuan'),
    '#default_value' => blank_theme_setting('hero_secondary_url'),
    '#description' => t('Dipakai bila <em>Nomor WhatsApp</em> di bagian Header kosong. Contoh: <code>/kontak</code>.'),
  ];

  $form['blank_theme_hero']['hero_features'] = [
    '#type' => 'textarea',
    '#title' => t('Daftar keunggulan'),
    '#default_value' => blank_theme_setting('hero_features'),
    '#rows' => 3,
    '#description' => t('Satu keunggulan per baris dengan format <code>Label|ikon</code>, mis. <code>Kualitas Terjamin|shield</code>. Ikon: <code>shield</code>, <code>truck</code>, <code>paw</code> (lihat map <code>hero_icons</code> di <code>templates/hero.html.twig</code>).'),

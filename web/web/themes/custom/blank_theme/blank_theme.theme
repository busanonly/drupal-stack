 *   $variables['attributes']['class'][] = 'theme-blank_theme';
 * }
 *
 * function blank_theme_theme_suggestions_page_alter(array &$suggestions, array $variables): void {
 *   if ($variables['is_front']) {
 *     $suggestions[] = 'blank_theme_page__front';
 *   }

# =====================================================================
#  Template konfigurasi Drupal web — drupal/web
#
#  Untuk project baru, JANGAN diedit manual. Dari root repo jalankan:
#     make init NAME=proyek2     # buat .env + network (belum start)
#     make new  NAME=proyek2     # init + start + composer install + settings
#  Script mengisi nama container/image, network, IP statis, port, password
#  database, dan salt secara otomatis. Nilai DB_* selalu sama dengan
#  ../database/.env.
#
#  Manual (bila perlu): cp .env.example .env  lalu sesuaikan nilainya.
#  Catatan: nilai di sini KONKRET (bukan ${...}) supaya Makefile & shell
#  tidak salah mengosongkannya.
# =====================================================================

# --- identitas project (diatur otomatis oleh `make init`) ---
PROJECT_NAME=drupal
COMPOSE_PROJECT_NAME=drupal_web
IMAGE_NAME=drupal/php
IMAGE_TAG=dev
DRUPAL_CONTAINER=drupal_php
NGINX_CONTAINER=drupal_nginx

# --- jaringan docker (harus sama dengan ../database/.env) ---
NETWORK_NAME=drupal-network
# dipakai `make network` saat membuat network (harus sama di kedua .env)
NETWORK_SUBNET=172.22.0.0/24
DRUPAL_IP=172.22.0.4
NGINX_IP=172.22.0.5

# --- port web di host -> container 80 ---
NGINX_PORT=8089
NGINX_BIND=0.0.0.0

# --- koneksi database (sama dengan ../database/.env) ---
# DB_HOST = nama container MariaDB (= CONTAINER_NAME di ../database/.env)
DB_HOST=drupal_db
DB_PORT=3306
DB_NAME=drupal
DB_USER=drupal
DB_PASSWORD=ubah_password_drupal_ini

# --- Drupal ---
# salt acak: openssl rand -hex 32
DRUPAL_HASH_SALT=ubah_salt_acak_ini
TZ=Asia/Jakarta


# --- port web di host -> container 80 ---
NGINX_PORT=8089
NGINX_BIND=0.0.0.0

# --- koneksi database (sama dengan ../database/.env) ---
# DB_HOST = nama container MariaDB (turunan PROJECT_NAME)
DB_HOST=${PROJECT_NAME}_db
DB_PORT=3306
DB_NAME=drupal
DB_USER=drupal
DB_PASSWORD=ubah_password_drupal_ini

# --- Drupal ---
# salt acak: openssl rand -hex 32
DRUPAL_HASH_SALT=ubah_salt_acak_ini
TZ=Asia/Jakarta


# --- Integrasi API Cek Ongkir v2 (api.co.id) — modul commerce_ongkir ---
# Isi dengan API key dari https://dashboard.api.co.id (header x-api-co-id).
# Dikirim ke container lewat env_file docker-compose, lalu dibaca modul dengan
# getenv('API_CO_ID_KEY') — API key tidak disimpan di database.
# Bisa juga diisi lewat $settings['commerce_ongkir_api_key'] di settings.php.
API_CO_ID_KEY=ubah_api_key_anda

# --- Integrasi payment gateway Midtrans Snap — modul commerce_midtrans ---
# Isi dari dashboard Midtrans: SETTINGS → Access Keys.
# MIDTRANS_MODE=sandbox → api.sandbox.midtrans.com + app.sandbox.midtrans.com/snap/snap.js.
# Untuk production isi MIDTRANS_SERVER_KEY_LIVE / MIDTRANS_CLIENT_KEY_LIVE dan ubah mode.
MIDTRANS_MODE=sandbox
MIDTRANS_SERVER_KEY=ubah_server_key_sandbox
MIDTRANS_CLIENT_KEY=ubah_client_key_sandbox
MIDTRANS_SERVER_KEY_LIVE=
MIDTRANS_CLIENT_KEY_LIVE=

# =====================================================================
#  Template konfigurasi Drupal web — drupal/web
#  Pakai:  cp .env.example .env  lalu sesuaikan password/salt/port.
#  Nilai DB_* HARUS sama dengan ../database/.env
# =====================================================================

# --- identitas project compose & container/image ---
COMPOSE_PROJECT_NAME=drupal_web
IMAGE_NAME=drupal/php
IMAGE_TAG=dev
DRUPAL_CONTAINER=drupal_php
NGINX_CONTAINER=drupal_nginx

# --- jaringan docker (harus sama dengan ../database/.env) ---
NETWORK_NAME=drupal-network
DRUPAL_IP=172.22.0.4
NGINX_IP=172.22.0.5

# --- port web di host -> container 80 ---
NGINX_PORT=8089
NGINX_BIND=0.0.0.0

# --- koneksi database (ambil dari ../database/.env) ---
# DB_HOST = nama container MariaDB (bisa juga dipakai IP statisnya)
DB_HOST=mariadb_drupal
DB_PORT=3306
DB_NAME=drupal
DB_USER=drupal
DB_PASSWORD=ubah_password_drupal_ini

# --- Drupal ---
# salt acak untuk settings.php: `openssl rand -hex 32`
DRUPAL_HASH_SALT=ubah_salt_acak_ini
TZ=Asia/Jakarta
